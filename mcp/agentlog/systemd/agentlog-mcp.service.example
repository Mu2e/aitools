# Reference template only. `scripts/agentlog-mcp-install-unit.sh` renders a
# fully resolved copy (with real paths and the real endpoint for your deploy)
# into this release's own share/agentlog-mcp/agentlog-mcp.service and registers
# it with `systemctl --user link` -- prefer that generated file over
# hand-editing this one.
#
# Install as a systemd --user unit (manual alternative to
# agentlog-mcp-install-unit.sh):
#   mkdir -p ~/.config/systemd/user
#   cp agentlog-mcp.service.example ~/.config/systemd/user/agentlog-mcp.service
#   # then edit every __PLACEHOLDER__ below
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentlog-mcp
#
# Requires linger enabled for this account so the service survives logout:
#   loginctl enable-linger        # or: sudo loginctl enable-linger <user>

[Unit]
Description=agentlog-mcp (agent investigation log MCP server, Postgres-backed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# MIKEY_KEYS_FILE is REQUIRED -- the key's name is recorded as every report's
# author, and the server refuses to start without it. The path is not itself a
# secret (the file's own permissions are the protection), so a plain
# Environment= line is fine. No database credentials appear anywhere: the
# connection is Kerberos-authenticated from the ambient environment.
Environment=MIKEY_KEYS_FILE=__MIKEY_KEYS_FILE__
#
# The database endpoint and the bind port are REQUIRED too, and are
# deliberately absent from the package -- supply them here (or in the
# EnvironmentFile below, which keeps them out of any file under git).
Environment=AGENTLOG_MCP_DB_HOST=__DB_HOST__
Environment=AGENTLOG_MCP_DB_PORT=__DB_PORT__
Environment=AGENTLOG_MCP_DB_NAME=__DB_NAME__
Environment=AGENTLOG_MCP_PORT=__PORT__
#
# Optional: the Kerberos credential cache, if it is somewhere non-default, plus
# any other site-specific variables. systemd parses this as plain KEY=VALUE
# lines -- `export KEY=VALUE` will NOT work here.
# EnvironmentFile=__ENV_FILE__
ExecStart=__DEPLOY_ROOT__/current/.venv/bin/agentlog-mcp.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
