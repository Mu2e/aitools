# Rendered by install-unit.sh; do not edit the installed copy (re-run it).
# One service for all automations of the data folder: every
# <project>/watches/<name>.json there, except those with "enabled": false.
[Unit]
Description=hep-genesis automations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A --user service starts in $HOME; everything it writes belongs in the data folder.
WorkingDirectory=@DATA_DIR@
Environment=HOME=@HOME_DIR@
Environment=HEP_PROJECTS_DIR=@DATA_DIR@/projects
Environment=HEP_WORKSPACE_DIR=@DATA_DIR@/workspace
Environment=HEP_STAGING_DIR=@DATA_DIR@/staging
Environment=DISPATCH_ARTIFACT_DIR=@DATA_DIR@/artifacts
Environment=HEP_SERVERS_FILE=@DATA_DIR@/servers.json
Environment=HEP_CONTEXT_FILE=@DEPLOY_ROOT@/current/site/context.md
Environment=HEP_MODEL_PRESETS_FILE=@DEPLOY_ROOT@/current/site/models.json
# Secrets (model key, the service's Mikey key) are in this file, mode 600,
# read by hep-genesis itself: never in the unit, never on a command line.
Environment=HEP_ENV_FILE=@ENV_FILE@
# No coding tasks from an unattended service. The .env file wins over this
# line: install-unit.sh refuses an .env that sets HEP_CODING.
Environment=HEP_CODING=0
Environment=PYTHONUNBUFFERED=1
# Usage accounting after every turn: counts only, to <data>/log/usage.jsonl,
# and to Postgres when the .env sets LOG_PG_DSN (and KRB5CCNAME).
Environment="HEP_TURN_HOOK=@DEPLOY_ROOT@/current/venv/bin/python @DEPLOY_ROOT@/current/usage/log-session.py"
ExecStart=@DEPLOY_ROOT@/current/bin/hep-genesis-agent --watch-all
# On SIGTERM each automation finishes the check it is in, saves its state and
# ends; one waiting on a slow server is killed after this long (its state is
# from its last finished check).
TimeoutStopSec=30
# The chats an automation starts are processes of their own: stopping or
# restarting the service must not kill an investigation in progress.
KillMode=process
# An unexpected error in one automation ends the process: start it again.
Restart=on-failure
RestartSec=60
# 2: no automation could run (every file or its tool is wrong). Not fixed by
# trying again.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
